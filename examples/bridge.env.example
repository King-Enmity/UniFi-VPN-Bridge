# Local-only configuration template for UniFi VPN Bridge
#
# This file contains PLACEHOLDERS, not an actual deployment.
# Copy it to /data/unifi-vpn-bridge/bridge.env ON YOUR ROUTER.
# Replace EVERY REPLACE_* value with a value you have verified on that router.
# Never commit bridge.env to GitHub or post its contents in public.
#
# WG_IF: interface of your UniFi WireGuard *SERVER* (incoming remote clients).
# Compare 'ip -o link show', 'ip -4 addr' and UniFi VPN Server subnet.
# Full guide: docs/FIND_YOUR_VPN.md
WG_IF=REPLACE_WITH_WIREGUARD_SERVER_INTERFACE

# VPN_IF: interface of your connected UniFi VPN *CLIENT* (outgoing provider).
# Verify the corresponding fwmark policy with: ip -4 rule show
# and: ip -4 route show table TABLE_NAME
VPN_IF=REPLACE_WITH_OUTBOUND_VPN_CLIENT_INTERFACE

# WG_CIDR: whole canonical IPv4 NETWORK of the WireGuard server clients,
# including /prefix; do not use the server's individual host IP.
# Find it with: ip -4 addr show dev YOUR_WG_IF
WG_CIDR=REPLACE_WITH_WIREGUARD_CLIENT_NETWORK_AND_PREFIX

# LAN_EXEMPTIONS: SPACE-SEPARATED destination networks that should use
# existing local/LAN routing instead of the commercial VPN.
# Replace with the actual LAN/VLAN/local VPN CIDRs you choose to preserve.
# Do not copy broad private ranges blindly; review every entry.
# The running firewall keeps LAN traffic subject to existing UniFi ACLs.
LAN_EXEMPTIONS="REPLACE_WITH_LOCAL_DESTINATION_CIDR"

# How frequently the systemd watchdog checks and restores missing hooks.
# 15 seconds was used during the observed reboot test; valid range 5..300.
UVB_INTERVAL=15
